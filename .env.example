# Copy to .env and adjust: cp .env.example .env

PORT=3000
NODE_ENV=development

# Signs cookies (@fastify/cookie). Generate: openssl rand -base64 32
COOKIE_SECRET=change-me

HEALTH_CHECK_ENABLED=true

THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Also used by docker-compose.yml to create the local database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_practice
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false
