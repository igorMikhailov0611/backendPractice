# Copy to .env and adjust: cp .env.example .env

PORT=3000
NODE_ENV=development

# Signs cookies (@fastify/cookie). Generate: openssl rand -base64 32
COOKIE_SECRET=change-me

HEALTH_CHECK_ENABLED=true

THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Also used by docker-compose.yml to create the local database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_practice
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# OpenAPI description + Swagger UI at /docs. Keep false in production.
API_DOCS_ENABLED=true

# Registration (spec §2). Method: otp | magic_link
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=otp
# Max POST /auth/register requests per minute per IP
REGISTRATION_RATE_LIMIT=10

# HMAC key for OTP / magic-link secrets. Must be >= 32 bytes or the app refuses to boot.
# Generate: openssl rand -base64 32
LOGIN_CHALLENGE_HMAC_KEY=change-me-to-a-random-value-of-at-least-32-bytes

# Outgoing mail. Defaults point at the local Mailpit container (UI: http://localhost:8025).
# SMTP_USER / SMTP_PASS are optional, but must be set together.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Backend Practice <no-reply@localhost>"

# Used to build magic links: ${FRONTEND_BASE_URL}/register/confirm#token=...
FRONTEND_BASE_URL=http://localhost:4200
