# Copy to .env and adjust: cp .env.example .env

PORT=3000
NODE_ENV=development

# Signs cookies (@fastify/cookie). Generate: openssl rand -base64 32
COOKIE_SECRET=change-me

HEALTH_CHECK_ENABLED=true

THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Also used by docker-compose.yml to create the local database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_practice
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# OpenAPI description + Swagger UI at /docs. Keep false in production.
API_DOCS_ENABLED=true

# Registration (spec §2). Method: otp | magic_link
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=otp
# Max POST /auth/register requests per minute per IP
REGISTRATION_RATE_LIMIT=10

# HMAC key for OTP / magic-link secrets. Must be >= 32 bytes or the app refuses to boot.
# Generate: openssl rand -base64 32
LOGIN_CHALLENGE_HMAC_KEY=change-me-to-a-random-value-of-at-least-32-bytes

# Authentication. Every key >= 32 bytes, and all four crypto keys (the three below +
# LOGIN_CHALLENGE_HMAC_KEY) must differ, or the app refuses to boot.
# Generate each one separately: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-key-random-value-of-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-key-random-value-of-at-least-32-bytes
# Irreversible email identifier for logs / login_failures
AUDIT_EMAIL_HMAC_KEY=change-me-audit-key-random-value-of-at-least-32-bytes
JWT_ISSUER=backend-practice-api
JWT_AUDIENCE=backend-practice-web
# Optional second login step. Method: otp | magic_link (affects only new logins)
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
# Comma-separated exact origins (no path, no trailing slash) allowed by CORS + CSRF.
# Empty = frontend and API share one origin.
TRUSTED_ORIGINS=http://localhost:4200
# true when the frontend is on another *site* → cookies get SameSite=None; Secure
AUTH_COOKIE_CROSS_SITE=false
# Max login / refresh requests per minute per IP
AUTH_RATE_LIMIT=30

# Outgoing mail. Defaults point at the local Mailpit container (UI: http://localhost:8025).
# SMTP_USER / SMTP_PASS are optional, but must be set together.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Backend Practice <no-reply@localhost>"

# Used to build magic links: ${FRONTEND_BASE_URL}/register/confirm#token=...
FRONTEND_BASE_URL=http://localhost:4200
